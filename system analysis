function drawN(n){const[k,t,num,l,x,y]=n,[w,h]=SZ[t];
if(t=='p')return `<rect class="o f" x="${x-w/2}" y="${y-h/2}" width="${w}" height="${h}" rx="10"/><path class="o" d="M${x-w/2} ${y-h/2+18}H${x+w/2}"/>`+T(x,y-h/2+13,num,'b')+wrap(l,x,y+9,24);
